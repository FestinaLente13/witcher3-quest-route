aster_Forgotten_Wolven_gauntlets"]},{"id":"fwolf.gm.4","n":"Trousers","ck":2,"l":["url","https://witcher.fandom.com/wiki/Grandmaster_Forgotten_Wolven_trousers"]},{"id":"fwolf.gm.5","n":"Silver Sword","ck":2,"l":["url","https://witcher.fandom.com/wiki/Grandmaster_Forgotten_Wolven_silver_sword"]},{"id":"fwolf.gm.6","n":"Steel Sword","ck":2,"l":["url","https://witcher.fandom.com/wiki/Grandmaster_Forgotten_Wolven_steel_sword"]}],"q":"q633"}]}],"trophies":[{"id":"base","guide":"https://psnprofiles.com/guide/2842-the-witcher-3-wild-hunt-trophy-guide","items":[{"id":"t3","n":"A Friend in Need","r":"Find and free Dandelion.","sp":1,"u":"https://witcher.fandom.com/wiki/A_Friend_in_Need"},{"id":"t4","n":"All In","r":"Play three hero cards in one round of gwent and win the match.","u":"https://witcher.fandom.com/wiki/All_In?so=search"},{"id":"t5","n":"Armed and Dangerous","r":"Find and equip all the elements of one set of witcher gear.","u":"https://witcher.fandom.com/wiki/Armed_and_Dangerous?so=search"},{"id":"t6","n":"Ashes to Ashes","r":"Complete the contract on Therazane.","u":"https://witcher.fandom.com/wiki/Ashes_to_Ashes?so=search"},{"id":"t7","n":"Assassin of Kings","r":"Take part in the assassination of King Radovid.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Assassin_of_Kings"},{"id":"t8","n":"Bombardier","r":"Collect the formulae for 6 different bomb types.","u":"https://witcher.fandom.com/wiki/Bombardier?so=search"},{"id":"t9","n":"Bookworm","r":"Read 30 books, journals or other documents.","u":"https://witcher.fandom.com/wiki/Bookworm?so=search"},{"id":"t10","n":"Brawl Master","r":"Complete all fistfighting quests in Velen, Skellige and Novigrad.","u":"https://witcher.fandom.com/wiki/Brawl_Master?so=search"},{"id":"t11","n":"Brawler","r":"Defeat Olaf, the Skellige champion of unarmed combat.","u":"https://witcher.fandom.com/wiki/Brawler?so=search"},{"id":"t12","n":"Butcher of Blaviken","r":"Kill at least 5 opponents in under 10 seconds.","u":"https://witcher.fandom.com/wiki/Butcher_of_Blaviken_(achievement)"},{"id":"t13","n":"Can't Touch This!","r":"Kill 5 foes in a fight without taking damage (except for Toxicity) and without using the Quen Sign.","u":"https://witcher.fandom.com/wiki/Can%27t_Touch_This!"},{"id":"t14","n":"Card Collector","r":"Acquire all gwent cards available in the base version of the game.","miss":1,"u":"https://witcher.fandom.com/wiki/Card_Collector"},{"id":"t15","n":"Dendrologist","r":"Acquire all the Abilities in one tree.","u":"https://witcher.fandom.com/wiki/Dendrologist?so=search"},{"id":"t16","n":"Environmentally Unfriendly","r":"Kill 50 opponents using the environment (e.g. swamp gas, insects or objects).","u":"https://witcher.fandom.com/wiki/Environmentally_Unfriendly"},{"id":"t17","n":"Even Odds","r":"Kill 2 monsters you have a contract on without using Signs, potions, mutagens, oils or bombs.","miss":1,"u":"https://witcher.fandom.com/wiki/Even_Odds?so=search"},{"id":"t18","n":"Family Counselor","r":"Find the baron's wife and daughter.","sp":1,"u":"https://witcher.fandom.com/wiki/Family_Counselor"},{"id":"t19","n":"Fast and Furious","r":"Win all the horse races in the game.","miss":1,"u":"https://witcher.fandom.com/wiki/Fast_and_Furious?so=search"},{"id":"t20","n":"Fearless Vampire Slayer","r":"Complete the contract on Sarasti.","u":"https://witcher.fandom.com/wiki/Fearless_Vampire_Slayer?so=search"},{"id":"t21","n":"Fiend or Foe?","r":"Complete the contract on Morvudd.","u":"https://witcher.fandom.com/wiki/Fiend_or_Foe%3F?so=search"},{"id":"t22","n":"Fire in the Hole","r":"Destroy 10 monster nests using bombs.","u":"https://witcher.fandom.com/wiki/Fire_in_the_Hole?so=search"},{"id":"t23","n":"Fist of the South Star","r":"Defeat an opponent in a fistfight without taking any damage.","u":"https://witcher.fandom.com/wiki/Fist_of_the_South_Star?so=search"},{"id":"t24","n":"Friends With Benefits","r":"Complete the subplot involving Keira Metz.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Friends_With_Benefits?so=search"},{"id":"t25","n":"Full Crew","r":"Bring all possible allies to Kaer Morhen for the battle against the Hunt.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Full_Crew"},{"id":"t26","n":"Geralt and Friends","r":"Win a round of gwent using only neutral cards.","u":"https://witcher.fandom.com/wiki/Geralt_and_Friends?so=search"},{"id":"t27","n":"Geralt: The Professional","r":"Complete all witcher contracts.","u":"https://witcher.fandom.com/wiki/Geralt:_The_Professional?so=search"},{"id":"t28","n":"Globetrotter","r":"Discover 100 fast travel points.","u":"https://witcher.fandom.com/wiki/Globetrotter?so=search"},{"id":"t29","n":"Gwent Master","r":"Defeat Tybalt and win the gwent tournament held at the Passiflora.","miss":1,"u":"https://witcher.fandom.com/wiki/Gwent_Master"},{"id":"t30","n":"Humpty Dumpty","r":"Kill 10 opponents by knocking them off somewhere high with the Aard Sign.","u":"https://witcher.fandom.com/wiki/Humpty_Dumpty"},{"id":"t31","n":"Kaer Morhen Trained","r":"Perform 10 effective counterattacks in a row without getting hit or parrying.","u":"https://witcher.fandom.com/wiki/Kaer_Morhen_Trained?so=search"},{"id":"t32","n":"Kingmaker","r":"Complete the subplot about choosing Skellige's ruler.","miss":1,"u":"https://witcher.fandom.com/wiki/Kingmaker?so=search"},{"id":"t33","n":"Let's Cook!","r":"Learn 12 potion formulae.","u":"https://witcher.fandom.com/wiki/Let's_Cook!?so=search"},{"id":"t34","n":"Lilac and Gooseberries","r":"Find Yennefer of Vengerberg.","sp":1,"u":"https://witcher.fandom.com/wiki/Lilac_and_Gooseberries_(achievement)?so=search"},{"id":"t35","n":"Master Marksman","r":"Kill 50 human and nonhuman opponents by striking them in the head with a crossbow bolt.","u":"https://youtu.be/0CTt6wdopHU?t=22031"},{"id":"t36","n":"Munchkin","r":"Reach character development level 35.","u":"https://witcher.fandom.com/wiki/Munchkin?so=search"},{"id":"t37","n":"Mutant","r":"Fill all mutagen slots.","u":"https://witcher.fandom.com/wiki/Mutant_(achievement)?so=search"},{"id":"t38","n":"Necromancer","r":"Help Yennefer extract information from Skjall's body.","sp":1,"u":"https://witcher.fandom.com/wiki/Necromancer?so=search"},{"id":"t39","n":"Overkill","r":"Make an opponent suffer from bleeding, poisoning and burning simultaneously. Do this 10 times.","u":"https://witcher.fandom.com/wiki/Overkill"},{"id":"t40","n":"Passed the Trial","r":"Finish the game on any difficulty.","u":"https://witcher.fandom.com/wiki/Passed_the_Trial?so=search"},{"id":"t41","n":"Pest Control","r":"Destroy all monster nests in the Velen / Novigrad region, or in Skellige.","u":"https://witcher.fandom.com/wiki/Pest_Control?so=search"},{"id":"t42","n":"Power Overwhelming","r":"Have all possible Place of Power bonuses active at the same time.","u":"https://witcher.fandom.com/wiki/Power_Overwhelming"},{"id":"t43","n":"Ran the Gauntlet","r":"Finish the game on the \"Blood and Broken Bones!\" or \"Death March!\" difficulty levels.","u":"https://witcher.fandom.com/wiki/Ran_the_Gauntlet?so=search"},{"id":"t44","n":"Shrieker","r":"Complete the contract on the shrieker.","u":"https://witcher.fandom.com/wiki/Shrieker_(achievement)?so=search"},{"id":"t45","n":"Something More","r":"Find Ciri.","sp":1,"u":"https://witcher.fandom.com/wiki/Something_More_(achievement)?so=search"},{"id":"t46","n":"That Is the Evilest Thing","r":"Ignite the gas produced by a Dragon's Dream bomb using a burning opponent. Do this 10 times.","u":"https://witcher.fandom.com/wiki/That_Is_the_Evilest_Thing"},{"id":"t47","n":"The Doppler Effect","r":"Resolve the doppler problem in Novigrad.","miss":1,"u":"https://witcher.fandom.com/wiki/The_Doppler_Effect?so=search"},{"id":"t48","n":"The Enemy of My Enemy","r":"Use the Axii Sign to force one opponent to kill another. Do this 20 times.","u":"https://witcher.fandom.com/wiki/The_Enemy_of_My_Enemy"},{"id":"t49","n":"The King is Dead","r":"Defeat Eredin.","sp":1,"u":"https://witcher.fandom.com/wiki/The_King_is_Dead?so=search"},{"id":"t50","n":"The Limits of the Possible","r":"Collect all trophies. Note: This is a PlayStation exclusive achievement.","u":"https://witcher.fandom.com/wiki/The_Limits_of_the_Possible?so=search"},{"id":"t51","n":"Triple Threat","r":"Kill 3 opponents in one fight using 3 different methods (sword, bombs, crossbow, Signs, etc.)","u":"https://witcher.fandom.com/wiki/Triple_Threat"},{"id":"t52","n":"Walked the Path","r":"Finish the game on the \"Death March!\" difficulty level.","u":"https://witcher.fandom.com/wiki/Walked_the_Path?so=search"},{"id":"t53","n":"What Was That?","r":"Attack, counter, cast a Sign and throw a bomb (in any order) in under 4 seconds.","u":"https://witcher.fandom.com/wiki/What_Was_That%3F"},{"id":"t54","n":"Woodland Spirit","r":"Complete the contract on the Woodland Spirit.","miss":1,"u":"https://witcher.fandom.com/wiki/Woodland_Spirit_(achievement)?so=search"},{"id":"t55","n":"Xenonaut","r":"Visit Tir ná Lia and convince Ge'els to betray Eredin.","sp":1,"u":"https://witcher.fandom.com/wiki/Xenonaut?so=search"}]},{"id":"hos","guide":"https://psnprofiles.com/guide/3447-the-witcher-3-wild-hunt-hearts-of-stone-dlc-trophy-guide","items":[{"id":"t58","n":"Can Quit Anytime I Want","r":"Be under the influence of seven potions or decoctions at the same time.","u":"https://witcher.fandom.com/wiki/Can_Quit_Anytime_I_Want"},{"id":"t59","n":"Curator of Nightmares","r":"Recreate all of Iris' nightmares in the Painted World.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Curator_of_Nightmares"},{"id":"t60","n":"I Wore Ofieri Before It Was Cool","r":"Collect all available Ofieri armor and horse gear, and at least one Ofieri sword.","u":"https://witcher.fandom.com/wiki/I_Wore_Ofieri_Before_It_Was_Cool"},{"id":"t61","n":"I'm Not Kissing That","r":"Kill the prince cursed into a toad.","sp":1,"u":"https://witcher.fandom.com/wiki/I'm_Not_Kissing_That?so=search"},{"id":"t62","n":"Killed It","r":"Win a round of gwent with a total strength of at least 187.","u":"https://witcher.fandom.com/wiki/Killed_It"},{"id":"t63","n":"Let the Good Times Roll!","r":"Participate in all the activities at the wedding.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Let_the_Good_Times_Roll!?so=search"},{"id":"t64","n":"Moo-rderer","r":"Kill 20 cows.","u":"https://witcher.fandom.com/wiki/Moo-rderer"},{"id":"t65","n":"Pacta Sunt Servanda","r":"Finish the \"Hearts of Stone\" expansion.","u":"https://witcher.fandom.com/wiki/Pacta_Sunt_Servanda_(achievement)?so=search"},{"id":"t66","n":"Rad Steez, Bro!","r":"Slide downhill uninterrupted for at least 10 seconds.","u":"https://witcher.fandom.com/wiki/Rad_Steez,_Bro!"},{"id":"t67","n":"Return to Sender","r":"Kill 3 opponents with their own arrows.","u":"https://witcher.fandom.com/wiki/Return_to_Sender"},{"id":"t68","n":"Shopaholic","r":"Buy all the items put on the block at the Borsodis' Auction House.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Shopaholic?so=search"},{"id":"t69","n":"When It's Many Against One...","r":"Provoke all Iris von Everec's Nightmares into fighting you at the same time and defeat them.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/When_It%27s_Many_Against_One..."},{"id":"t70","n":"Wild Rose Dethorned","r":"Destroy all the fallen knights of the Order of the Flaming Rose's campsites.","u":"https://witcher.fandom.com/wiki/Wild_Rose_Dethorned?so=search"}]},{"id":"baw","guide":"https://psnprofiles.com/guide/6581-the-witcher-3-wild-hunt-blood-and-wine-dlc-trophy-guide","items":[{"id":"t73","n":"A Knight to Remember","r":"Obtain a flawless victory in all the competitions during the knights' tourney.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/A_Knight_to_Remember?so=search"},{"id":"t74","n":"David and Golyat","r":"Kill Golyat with a crossbow bolt to his eye.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/David_and_Golyat"},{"id":"t75","n":"Dressed to Kill","r":"Unlock the bonus for equipping all the witcher gear elements from one School.","u":"https://witcher.fandom.com/wiki/Dressed_to_Kill"},{"id":"t76","n":"Embodiment of the Five Virtues","r":"Be given Aerondight by the Lady of the Lake.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Embodiment_of_the_Five_Virtues"},{"id":"t77","n":"Hasta la Vista™","r":"Kill a frozen opponent with a crossbow bolt.","u":"https://witcher.fandom.com/wiki/Hasta_la_Vista%E2%84%A2"},{"id":"t78","n":"I Have a Gwent Problem","r":"Collect all the cards in the Skellige deck.","u":"https://witcher.fandom.com/wiki/I_Have_a_Gwent_Problem?so=search"},{"id":"t79","n":"Kling of the Clink","r":"Serve time in Toussaint.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Kling_of_the_Clink"},{"id":"t80","n":"Last Action Hero","r":"Be decorated with the Order of Vitis Vinifera.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/Last_Action_Hero"},{"id":"t81","n":"Playing House","r":"Use all available options for developing Corvo Bianco.","sp":1,"u":"https://witcher.fandom.com/wiki/Playing_House?so=search"},{"id":"t82","n":"The Grapes of Wrath Stomped","r":"Help unite the warring vineyards and have wine named in your honor.","miss":1,"sp":1,"u":"https://witcher.fandom.com/wiki/The_Grapes_of_Wrath_Stomped"},{"id":"t83","n":"The Witcher's Gone South","r":"Travel to the Duchy of Toussaint.","u":"https://witcher.fandom.com/wiki/The_Witcher's_Gone_South?so=search"},{"id":"t84","n":"Turned Every Stone","r":"Find all grandmaster diagrams for each witcher school.","u":"https://witcher.fandom.com/wiki/Turned_Every_Stone?so=search"},{"id":"t85","n":"Weapon \"W\"","r":"Develop a mutation.","u":"https://witcher.fandom.com/wiki/Weapon_%22W%22"}]}],"challenges":[{"id":"c2","n":"Deathmarch","d":"Play on the deathmarch difficulty"},{"id":"c3","n":"Scaling","d":"Enemy scaling is on"},{"id":"c4","n":"Quen Quitter","d":"You cannot use Quen at all throughout the playthrough"},{"id":"c5","n":"Mere Mortal","d":"No signs allowed in combat (they can be used for story missions and quests, to light fires, clear terrain, etc. but nothing in combat"},{"id":"c6","n":"Instrument of Death","d":"Combat abilities only, no ability points can be spent on signs, alchemy, or general abilities"},{"id":"c7","n":"The Jedi Way","d":"Sign abilities only, no ability points can be spent on combat, alchemy, or general abilities"},{"id":"c8","n":"Lead into Gold","d":"Alchemy abilities only, no ability points can be spent on combat, signs, or general abilities"},{"id":"c9","n":"Plain Jane","d":"General abilities only, no ability points can be spent on combat, signs, or alchemy abilities"},{"id":"c10","n":"Mr. Tough Guy","d":"No ability points can be used at all"},{"id":"c11","n":"Greasy Spoon","d":"You cannot use the gourmet ability"},{"id":"c12","n":"Top-Shelf Taste","d":"Only decoctions can be used, no potions allowed"},{"id":"c13","n":"Off the Sauce","d":"No potions or decoctions allowed"},{"id":"c14","n":"Going in Dry","d":"No oils allowed"},{"id":"c15","n":"Purebred","d":"No mutagens allowed"},{"id":"c16","n":"Get Off My Lawn","d":"No looting huts, houses, forts, businesses, or anywhere that someone owns or is clearly inhabiting. If a hut, village, house, etc. appears deserted, THEN you may loot it. If it appears to possibly be in use/inhabited, you should not loot"},{"id":"c17","n":"Scavenger","d":"You cannot buy anything from anyone. You can only craft, repair, dismantle, and sell things"},{"id":"c18","n":"Scavenger Souse","d":"You cannot buy anything from anyone EXCEPT any ingredients needed to brew white gull. This enables you to create the superior forms of alchemy items and craft advanced witcher gear. You can still craft, repair, dismantle, and sell anything"},{"id":"c19","n":"Hunter","d":"You cannot loot anything EXCEPT from beings/corpses that you killed, with a few exceptions. You can loot things that are mandatory for main story quest progression, things for witcher contracts, and you can loot witcher equipment diagrams. You cannot loot ANYTHING else for any other quests, missions, etc. Destroying a monster nest counts as a kill, so you can loot monster nests, but otherwise you cannot loot anything except from the corpses of monsters, beasts, or humanoids that you yourself killed. Thus, you cannot loot any guarded treasures, bandit camps, treasure hunt chests/items, any already dead corpses, any chests, boxes, crates, sacks, packages, satchels, or anything else in the environment. This includes plants/herbs. You can still craft, repair, dismantle, and buy and sell anything."},{"id":"c20","n":"Basic","d":"No witcher weapons or armor allowed"},{"id":"c21","n":"Fancy Boy","d":"Witcher weapons and armor ONLY, no other weapons or armor allowed"},{"id":"c22","n":"One-of-a-Kind","d":"Only unique weapons allowed. Only weapons that have special names and are clearly unique can be used, such as Moonblade, Aerondight, Caroline, etc. You can find these weapons and craft/buy them. However, no witcher armor/weapons allowed"},{"id":"c23","n":"Bespoke Banditry","d":"Custom-made weapons and armor only. You can only use weapons and armor that you yourself CRAFT at armorers and smiths. No witcher armor/weapons allowed"},{"id":"c24","n":"Breath of the Wild","d":"No repairs allowed. If something breaks, discard it, sell it, dismantly it, etc. but you cannot repair anything"},{"id":"c25","n":"No Recycling","d":"You cannot dismantle anything"},{"id":"c26","n":"Dark Souls","d":"You can only meditate next to a bonfire OR a place of increased safety (inside a tavern, inn, etc.)"},{"id":"c27","n":"Save Your Breath","d":"You can only save at sign posts"},{"id":"c28","n":"Map Hater","d":"No minimap allowed (turn off in the options). You can still bring up the main map for navigation"},{"id":"c29","n":"Know Your Enemy","d":"No enemy health bars allowed to be displayed (turn off in the options)"},{"id":"c30","n":"Know Your Boss","d":"No boss health bars allowed to be displayed (turn off in the options)"},{"id":"c31","n":"Where's My Health Bar?","d":"Turn off your health bar in the options (the entire HUD)"},{"id":"c32","n":"Globetrotter","d":"No fast travel allowed (except when needed to leave a map/enter a new map)"},{"id":"c33","n":"1 Up","d":"You can die once in a combat encounter/fight, but you must immediately return to that encounter/fight after you reload into the game and if you die again, it's game over for good. You must start a completely new game. You can die multiple times in a playthrough, but you can only die once per fight"},{"id":"c34","n":"The Extreme","d":"If you die even once, it's game over for good. You must start a completely new game"},{"id":"c35","n":"Gwenter","d":"Play Gwent on the max difficulty (can be changed in the settings)"},{"id":"c36","n":"Gwent Extremist","d":"You must use all the cards you acquire and put them in your deck (this makes it challenging since it is less likely to get the good cards in each hand). You cannot have the 25 minimum number of cards."}],"credits":{"challenges":"llamanthesky"}}